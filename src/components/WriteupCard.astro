---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"writeups">;
}

const { post } = Astro.props;
const { title, description, platform, category, difficulty, publishedAt, tags } = post.data;
const formattedDate = publishedAt.toLocaleDateString("vi-VN", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
const searchableText = [title, description, platform, category, difficulty, ...tags]
  .join(" ")
  .toLocaleLowerCase("vi");
---

<article
  class="writeup-card"
  data-writeup-card
  data-platform={platform}
  data-difficulty={difficulty}
  data-search={searchableText}
>
  <a class="card-link" href={`/writeups/${post.id}/`} aria-label={`Đọc write-up ${title}`}>
    <div class="card-topline">
      <span class="platform">{platform}</span>
      <span class:list={["difficulty", `difficulty-${difficulty.toLowerCase()}`]}>{difficulty}</span>
    </div>

    <h2>{title}</h2>
    <p class="description">{description}</p>

    <div class="card-bottom">
      <span>{category}</span>
      <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
    </div>
  </a>
</article>

<style>
  .writeup-card {
    min-width: 0;
    border-bottom: 1px solid var(--line);
  }

  .writeup-card[hidden] {
    display: none;
  }

  .card-link {
    display: block;
    min-height: 15rem;
    padding: 1.5rem 0;
    text-decoration: none;
  }

  .card-topline,
  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .platform,
  .difficulty,
  .card-bottom {
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .platform {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .difficulty {
    color: var(--ink-soft);
  }

  .difficulty-easy {
    color: var(--success);
  }

  .difficulty-medium {
    color: var(--warning);
  }

  .difficulty-hard,
  .difficulty-insane {
    color: var(--accent);
  }

  h2 {
    max-width: 24ch;
    margin: 1.5rem 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
    transition: color 180ms ease;
  }

  .card-link:hover h2 {
    color: var(--accent-strong);
  }

  .description {
    display: -webkit-box;
    max-width: 34rem;
    margin: 0.7rem 0 1.5rem;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-bottom {
    margin-top: auto;
    color: var(--ink-soft);
  }

  @media (max-width: 42rem) {
    .card-link {
      min-height: 0;
    }
  }
</style>
