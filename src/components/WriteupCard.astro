---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { writeupPath } from "../i18n";

interface Props {
  post: CollectionEntry<"writeups">;
  featured?: boolean;
  titleAs?: "h2" | "h3";
  locale?: Locale;
}

const { post, featured = false, titleAs = "h2", locale = post.data.language } = Astro.props;
const { title, description, platform, category, difficulty, publishedAt, tags } = post.data;
const formattedDate = publishedAt.toLocaleDateString(locale === "vi" ? "vi-VN" : "en-US", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
const searchableText = [title, description, platform, category, difficulty, ...tags]
  .join(" ")
  .toLocaleLowerCase(locale);
---

<article
  class:list={["writeup-card", { featured }]}
  data-writeup-card
  data-platform={platform}
  data-category={category}
  data-difficulty={difficulty}
  data-search={searchableText}
>
  <a class="card-link" href={writeupPath(post.data.translationKey, locale)} aria-label={`${locale === "vi" ? "Đọc" : "Read"} write-up ${title}`}>
    <div class="card-main">
      <div class="card-topline">
        <span class="platform">{platform}</span>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
        <span aria-hidden="true">/</span>
        <span class="difficulty">{difficulty}</span>
      </div>

      {
        titleAs === "h3" ? (
          <h3>{title}</h3>
        ) : (
          <h2>{title}</h2>
        )
      }
      <p class="description">{description}</p>
    </div>

    <div class="card-bottom">
      <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
      <span>{tags.slice(0, featured ? 3 : 2).map((tag) => `#${tag}`).join(" ")}</span>
    </div>
  </a>
</article>

<style>
  .writeup-card {
    min-width: 0;
    border-bottom: 1px solid rgba(217, 70, 239, 0.15);
  }

  .writeup-card:first-child {
    border-top: 1px solid rgba(217, 70, 239, 0.15);
  }

  .writeup-card.featured {
    border: 0;
  }

  .writeup-card[hidden] {
    display: none;
  }

  .card-link {
    display: grid;
    min-height: 8.5rem;
    padding: 1.35rem 0;
    align-items: start;
    grid-template-columns: minmax(0, 1fr) 11rem;
    gap: 2rem;
    text-decoration: none;
  }

  .featured .card-link {
    min-height: 14rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: var(--glass-shadow);
    grid-template-columns: minmax(0, 1fr) 12rem;
    transition: all 280ms ease;
  }

  .card-main {
    min-width: 0;
  }

  .card-topline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .card-topline,
  .card-bottom {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .platform {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .difficulty {
    font-weight: 700;
  }

  h2,
  h3 {
    max-width: 30ch;
    margin: 0.6rem 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.15rem + 0.65vw, 1.75rem);
    font-weight: 650;
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-wrap: balance;
    transition: color 180ms ease;
  }

  .featured h2,
  .featured h3 {
    max-width: 20ch;
    font-size: clamp(1.8rem, 1.3rem + 1.5vw, 2.6rem);
    line-height: 1.1;
  }

  .card-link:hover h2,
  .card-link:hover h3 {
    color: var(--accent-strong);
  }

  .description {
    max-width: 58ch;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .card-bottom {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    text-align: right;
  }

  .card-bottom span {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-link:hover {
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(12px);
  }

  .featured .card-link:hover {
    border-color: rgba(217, 70, 239, 0.4);
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px) saturate(200%);
    box-shadow: 0 12px 40px 0 rgba(217, 70, 239, 0.25);
    transform: translateY(-2px);
  }

  @media (max-width: 42rem) {
    .card-link {
      min-height: 0;
      padding-block: 1.25rem;
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .featured .card-link {
      min-height: 0;
      padding: 1.25rem;
      grid-template-columns: 1fr;
    }

    .card-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
