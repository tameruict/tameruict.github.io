---
import { alternateLocalePath, localizedPath, localeFromPath, ui } from "../i18n";

const pathname = Astro.url.pathname;
const locale = localeFromPath(pathname);
const copy = ui[locale];
const homePath = localizedPath("/", locale);
const writeupsPath = localizedPath("/writeups/", locale);
const alternatePath = alternateLocalePath(pathname);
const isHome = pathname === homePath;
const isWriteups = pathname === writeupsPath || pathname.startsWith(`${writeupsPath}`);
---

<header class="site-header">
  <div class="header-shell">
    <a class="wordmark" href={homePath} aria-label={copy.homeLabel}>
      <strong>Tameru</strong>
    </a>

    <div class="header-actions">
      <nav aria-label={copy.navLabel}>
        <a href={homePath} aria-current={isHome ? "page" : undefined}>{copy.home}</a>
        <a href={writeupsPath} aria-current={isWriteups ? "page" : undefined}>Write-ups</a>
      </nav>

      <a class="language-switch" href={alternatePath} hreflang={locale === "vi" ? "en" : "vi"} aria-label={copy.switchLabel}>
        <span class:list={{ active: locale === "vi" }}>VI</span>
        <span aria-hidden="true">/</span>
        <span class:list={{ active: locale === "en" }}>EN</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 4px 24px 0 rgba(217, 70, 239, 0.1);
  }

  .header-shell {
    display: flex;
    width: min(calc(100% - 2.5rem), var(--page-width));
    min-height: 4.25rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .language-switch {
    display: inline-flex;
    min-height: 2.75rem;
    padding-inline: 0.7rem;
    align-items: center;
    gap: 0.3rem;
    border-left: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .language-switch:hover {
    color: var(--accent-strong);
  }

  .language-switch .active {
    color: var(--ink);
  }

  nav a {
    display: inline-flex;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    align-items: center;
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    background: rgba(255, 255, 255, 0.3);
    color: var(--accent-strong);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(217, 70, 239, 0.15);
  }

  nav a[aria-current="page"] {
    background: rgba(217, 70, 239, 0.2);
    color: var(--accent-strong);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(217, 70, 239, 0.3);
    box-shadow: 0 4px 12px rgba(217, 70, 239, 0.25);
  }

  @media (max-width: 37rem) {
    .header-shell {
      width: min(calc(100% - 1.25rem), var(--page-width));
      min-height: 4rem;
      gap: 0.4rem;
    }

    nav {
      gap: 0;
    }

    nav a {
      padding-inline: 0.55rem;
      font-size: 0.75rem;
    }

    .header-actions {
      gap: 0.15rem;
    }

    .language-switch {
      padding-inline: 0.45rem;
      font-size: 0.62rem;
    }

    nav a:first-child {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: rgba(255, 238, 245, 0.95);
      backdrop-filter: none;
    }
  }
</style>
