---
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isWriteups = pathname.startsWith("/writeups");
---

<header class="site-header">
  <div class="header-shell">
    <a class="wordmark" href="/" aria-label="Tameru Write-ups, trang chủ">
      <span>
        <strong>Tameru</strong>
        <small>write-ups</small>
      </span>
    </a>

    <nav aria-label="Điều hướng chính">
      <a href="/" aria-current={isHome ? "page" : undefined}>Trang chủ</a>
      <a href="/writeups/" aria-current={isWriteups ? "page" : undefined}>Write-ups</a>
      <a href="/about/" aria-current={pathname.startsWith("/about") ? "page" : undefined}>Giới thiệu</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: var(--header-surface);
    backdrop-filter: blur(12px);
  }

  .header-shell {
    display: flex;
    width: min(calc(100% - 2rem), var(--page-width));
    min-height: 4.8rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    color: var(--accent-strong);
    text-decoration: none;
  }

  .wordmark strong,
  .wordmark small {
    display: block;
    line-height: 1;
  }

  .wordmark strong {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .wordmark small {
    margin-top: 0.22rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
  }

  nav a {
    position: relative;
    padding-block: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--accent);
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--accent-strong);
  }

  nav a:hover::after,
  nav a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 37rem) {
    .header-shell {
      width: min(calc(100% - 1.25rem), var(--page-width));
      min-height: 4.2rem;
      gap: 0.85rem;
    }

    .wordmark small {
      display: none;
    }

    nav {
      gap: 0.85rem;
    }

    nav a {
      font-size: 0.78rem;
    }

    nav a:last-child {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--paper);
      backdrop-filter: none;
    }
  }
</style>
