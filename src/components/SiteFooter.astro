---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-shell">
    <p>Tameru Write-ups</p>
    <div class="footer-links">
      <a href="https://github.com/tameruict" rel="me">GitHub</a>
      <a href="/rss.xml">RSS</a>
      <span>© {year}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: 0 -4px 24px 0 rgba(217, 70, 239, 0.1);
  }

  .footer-shell {
    display: flex;
    width: min(calc(100% - 2.5rem), var(--page-width));
    min-height: 6rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-shell > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  .footer-links a:hover {
    color: var(--accent-strong);
  }

  @media (max-width: 37rem) {
    .footer-shell {
      width: min(calc(100% - 1.25rem), var(--page-width));
      min-height: 8rem;
      padding-block: 1.25rem;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.4rem;
    }
  }
</style>
