---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-shell">
    <p>Tameru Write-ups</p>
    <div class="footer-links">
      <a href="https://github.com/tameruict" rel="me">GitHub</a>
      <a href="/rss.xml">RSS</a>
      <span>© {year}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
  }

  .footer-shell {
    display: flex;
    width: min(calc(100% - 2rem), var(--page-width));
    min-height: 6.5rem;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-shell > p {
    margin: 0;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .footer-links a:hover {
    color: var(--accent-strong);
  }

  @media (max-width: 37rem) {
    .footer-shell {
      width: min(calc(100% - 1.25rem), var(--page-width));
      min-height: 7.5rem;
    }
  }
</style>
