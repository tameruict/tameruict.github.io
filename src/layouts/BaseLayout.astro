---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { alternateLocalePath, localeFromPath, localizedPath, ui } from "../i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = "Tameru Write-ups",
  description = "Write-up CTF của Tameru.",
  image,
  article = false,
} = Astro.props;

const pageTitle = title === "Tameru Write-ups" ? title : `${title} | Tameru Write-ups`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
const rssURL = new URL("/rss.xml", Astro.site ?? Astro.url);
const locale = localeFromPath(Astro.url.pathname);
const alternateURL = new URL(alternateLocalePath(Astro.url.pathname), Astro.site ?? Astro.url);
const copy = ui[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f6f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1211" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={locale === "vi" ? "en" : "vi"} href={alternateURL} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(Astro.url.pathname, "vi"), Astro.site ?? Astro.url)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Tameru Write-ups" href={rssURL} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={locale === "vi" ? "vi_VN" : "en_US"} />
    <meta property="og:site_name" content="Tameru Write-ups" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
