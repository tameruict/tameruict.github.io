---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import WriteupCard from "../../components/WriteupCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("writeups", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, posts },
  }));
}

interface Props {
  post: CollectionEntry<"writeups">;
  posts: CollectionEntry<"writeups">[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, platform, category, difficulty, publishedAt, updatedAt, tags, cover } =
  post.data;
const formattedDate = publishedAt.toLocaleDateString("vi-VN", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
const formattedUpdatedDate = updatedAt?.toLocaleDateString("vi-VN", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
const relatedPosts = posts
  .filter((candidate) => candidate.id !== post.id)
  .map((candidate) => ({
    post: candidate,
    score:
      (candidate.data.platform === platform ? 3 : 0) +
      candidate.data.tags.filter((tag) => tags.includes(tag)).length,
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map(({ post: candidate }) => candidate);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BaseLayout title={title} description={description} image={cover} article>
  <article class="article-shell shell">
    <nav class="breadcrumb" aria-label="Đường dẫn">
      <a href="/">Trang chủ</a>
      <span aria-hidden="true">/</span>
      <a href="/writeups/">Write-ups</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <header class="article-header">
      <div class="article-kicker">
        <span>{platform}</span>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
        <span aria-hidden="true">/</span>
        <span>{difficulty}</span>
      </div>

      <h1>{title}</h1>
      <p class="article-description">{description}</p>

      <div class="header-details">
        <dl class="article-meta">
          <div>
            <dt>Đăng</dt>
            <dd><time datetime={publishedAt.toISOString()}>{formattedDate}</time></dd>
          </div>
          {
            formattedUpdatedDate && (
              <div>
                <dt>Cập nhật</dt>
                <dd>
                  <time datetime={updatedAt?.toISOString()}>{formattedUpdatedDate}</time>
                </dd>
              </div>
            )
          }
        </dl>

        {tags.length > 0 && (
          <ul class="article-tags" aria-label="Thẻ bài viết">
            {tags.map((tag) => <li>#{tag}</li>)}
          </ul>
        )}
      </div>
    </header>

    <div class="article-grid">
      <div class="prose">
        <Content />
      </div>

      {
        tocHeadings.length > 0 && (
          <aside class="toc">
            <nav aria-labelledby="toc-title">
              <p id="toc-title">Trong bài này</p>
              <ol>
                {tocHeadings.map((heading) => (
                  <li class:list={{ nested: heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="related shell" aria-labelledby="related-title">
        <header>
          <h2 id="related-title">Đọc tiếp</h2>
          <p>Các bài có cùng nền tảng hoặc kỹ thuật liên quan.</p>
        </header>
        <div class="related-list">
          {relatedPosts.map((relatedPost) => (
            <WriteupCard post={relatedPost} titleAs="h3" />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .article-shell {
    width: min(calc(100% - clamp(2rem, 5vw, 6rem)), 112rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 8vw, 7rem);
  }

  .breadcrumb {
    display: flex;
    min-height: 2.75rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .breadcrumb a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--accent-strong);
  }

  .breadcrumb span[aria-current="page"] {
    max-width: 28rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-header {
    max-width: 72rem;
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .article-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .article-header h1 {
    max-width: 16ch;
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 6.5vw, 5.4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    text-wrap: balance;
  }

  .article-description {
    max-width: 48rem;
    margin: 1.35rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 0.94rem + 0.34vw, 1.18rem);
    line-height: 1.65;
  }

  .header-details {
    display: flex;
    margin-top: 2rem;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .article-meta {
    display: flex;
    margin: 0;
    gap: 1rem 2rem;
  }

  .article-meta div {
    display: grid;
    gap: 0.15rem;
  }

  .article-meta dt,
  .article-meta dd,
  .article-tags {
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .article-meta dt {
    color: var(--ink-soft);
  }

  .article-meta dd {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
  }

  .article-tags {
    display: flex;
    max-width: 34rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 0.75rem;
    color: var(--accent-strong);
    list-style: none;
  }

  .article-grid {
    display: grid;
    margin-top: clamp(3rem, 7vw, 5rem);
    align-items: start;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .article-grid .prose {
    width: 100%;
    max-width: none;
  }

  .article-grid :global(.prose > :where(p, ul, ol, blockquote, h2, h3, h4)) {
    max-width: 82ch;
  }

  .article-grid :global(.prose > p:has(> img)) {
    max-width: none;
  }

  .toc {
    position: sticky;
    top: 6rem;
    width: 100%;
    padding-top: 1rem;
    border-top: 2px solid var(--accent);
  }

  .toc p {
    margin: 0 0 0.9rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc li + li {
    margin-top: 0.6rem;
  }

  .toc .nested {
    padding-left: 0.85rem;
  }

  .toc a {
    display: block;
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }

  .related {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid var(--line-strong);
  }

  .related header {
    margin-bottom: 1.75rem;
  }

  .related h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.5rem + 1vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .related header p {
    margin: 0.45rem 0 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .related-list {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (max-width: 68rem) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .toc {
      position: static;
      grid-row: 1;
      max-width: 52rem;
      padding: 1rem;
      border: 1px solid var(--line);
      border-top: 2px solid var(--accent);
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      background: var(--surface);
    }

    .toc ol {
      columns: 2;
      column-gap: 2rem;
    }

    .toc li {
      break-inside: avoid;
    }

    .toc a {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
    }
  }

  @media (max-width: 42rem) {
    .article-shell {
      width: min(calc(100% - 1.25rem), 112rem);
    }

    .article-header h1 {
      font-size: clamp(2.65rem, 13vw, 4.2rem);
    }

    .header-details,
    .article-meta {
      flex-direction: column;
    }

    .article-tags {
      justify-content: flex-start;
    }

    .toc ol {
      columns: 1;
    }
  }
</style>
