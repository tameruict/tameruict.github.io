---
import { getCollection } from "astro:content";
import WriteupCard from "../../components/WriteupCard.astro";
import { localeFromPath } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = localeFromPath(Astro.url.pathname);
const copy = locale === "vi"
  ? {
      description: "Write-up CTF của Tameru.", count: "bài viết", list: "Danh sách write-up",
      search: "Tìm kiếm", placeholder: "Challenge, tag hoặc kỹ thuật", platform: "Nền tảng",
      allPlatforms: "Tất cả nền tảng", category: "Chủ đề", allCategories: "Tất cả chủ đề",
      difficulty: "Độ khó", allDifficulties: "Tất cả độ khó", reset: "Đặt lại",
      results: "Kết quả", noWriteups: "Chưa có write-up", noResults: "Không có kết quả",
      noResultsHelp: "Thử một từ khóa khác hoặc bỏ bớt bộ lọc.", showAll: "Hiện tất cả",
    }
  : {
      description: "CTF write-ups by Tameru.", count: "articles", list: "Write-up list",
      search: "Search", placeholder: "Challenge, tag, or technique", platform: "Platform",
      allPlatforms: "All platforms", category: "Category", allCategories: "All categories",
      difficulty: "Difficulty", allDifficulties: "All difficulties", reset: "Reset",
      results: "Results", noWriteups: "No write-ups yet", noResults: "No results",
      noResultsHelp: "Try another keyword or remove some filters.", showAll: "Show all",
    };
const posts = (await getCollection("writeups", ({ data }) => !data.draft && data.language === locale)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const platforms = [...new Set(posts.map(({ data }) => data.platform))].sort((a, b) =>
  a.localeCompare(b),
);
const categories = [...new Set(posts.map(({ data }) => data.category))].sort((a, b) =>
  a.localeCompare(b),
);
---

<BaseLayout
  title="Write-ups"
  description={copy.description}
>
  <header class="archive-header shell">
    <div>
      <h1>Write-ups</h1>
      <p>{posts.length} {copy.count}</p>
    </div>
  </header>

  <section class="archive shell" aria-labelledby="archive-results-title">
    <h2 class="visually-hidden" id="archive-results-title">{copy.list}</h2>

    <form class="filters" data-filter-form role="search">
      <div class="field search-field">
        <label for="writeup-search">{copy.search}</label>
        <input
          id="writeup-search"
          name="query"
          type="search"
          autocomplete="off"
          placeholder={copy.placeholder}
        />
      </div>

      <div class="field">
        <label for="platform-filter">{copy.platform}</label>
        <select id="platform-filter" name="platform">
          <option value="">{copy.allPlatforms}</option>
          {platforms.map((platform) => <option value={platform}>{platform}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="category-filter">{copy.category}</label>
        <select id="category-filter" name="category">
          <option value="">{copy.allCategories}</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="difficulty-filter">{copy.difficulty}</label>
        <select id="difficulty-filter" name="difficulty">
          <option value="">{copy.allDifficulties}</option>
          <option value="Easy">Easy</option>
          <option value="Medium">Medium</option>
          <option value="Hard">Hard</option>
          <option value="Insane">Insane</option>
        </select>
      </div>

      <button class="clear-button" type="reset">{copy.reset}</button>
    </form>

    <div class="result-summary" aria-live="polite">
      <span>{copy.results}</span>
      <strong><span data-visible-count>{posts.length}</span> / {posts.length}</strong>
    </div>

    {
      posts.length > 0 ? (
        <div class="writeup-list" data-writeup-list>
          {posts.map((post) => <WriteupCard post={post} locale={locale} />)}
        </div>
      ) : (
        <div class="empty-state static-empty">
          <h3>{copy.noWriteups}</h3>
        </div>
      )
    }

    <div class="empty-state" data-filter-empty hidden aria-live="polite">
      <h3>{copy.noResults}</h3>
      <p>{copy.noResultsHelp}</p>
      <button type="button" data-empty-reset>{copy.showAll}</button>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-filter-form]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-writeup-card]")];
    const visibleCount = document.querySelector<HTMLElement>("[data-visible-count]");
    const emptyState = document.querySelector<HTMLElement>("[data-filter-empty]");
    const searchInput = document.querySelector<HTMLInputElement>("#writeup-search");
    const platformSelect = document.querySelector<HTMLSelectElement>("#platform-filter");
    const categorySelect = document.querySelector<HTMLSelectElement>("#category-filter");
    const difficultySelect = document.querySelector<HTMLSelectElement>("#difficulty-filter");

    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLocaleLowerCase(document.documentElement.lang)
        .trim();

    const setInitialFilters = () => {
      const params = new URLSearchParams(window.location.search);
      if (searchInput) searchInput.value = params.get("query") ?? "";
      if (platformSelect) platformSelect.value = params.get("platform") ?? "";
      if (categorySelect) categorySelect.value = params.get("category") ?? "";
      if (difficultySelect) difficultySelect.value = params.get("difficulty") ?? "";
    };

    const updateURL = () => {
      if (!searchInput || !platformSelect || !categorySelect || !difficultySelect) return;
      const params = new URLSearchParams();
      if (searchInput.value.trim()) params.set("query", searchInput.value.trim());
      if (platformSelect.value) params.set("platform", platformSelect.value);
      if (categorySelect.value) params.set("category", categorySelect.value);
      if (difficultySelect.value) params.set("difficulty", difficultySelect.value);
      const query = params.toString();
      window.history.replaceState(null, "", query ? `${window.location.pathname}?${query}` : window.location.pathname);
    };

    const applyFilters = ({ updateHistory = true } = {}) => {
      if (!searchInput || !platformSelect || !categorySelect || !difficultySelect) return;

      const query = normalize(searchInput.value);
      const platform = platformSelect.value;
      const category = categorySelect.value;
      const difficulty = difficultySelect.value;
      let count = 0;

      cards.forEach((card) => {
        const searchText = normalize(card.dataset.search ?? "");
        const matches =
          (!query || searchText.includes(query)) &&
          (!platform || card.dataset.platform === platform) &&
          (!category || card.dataset.category === category) &&
          (!difficulty || card.dataset.difficulty === difficulty);

        card.hidden = !matches;
        if (matches) count += 1;
      });

      if (visibleCount) visibleCount.textContent = String(count);
      if (emptyState) emptyState.hidden = count !== 0 || cards.length === 0;
      if (updateHistory) updateURL();
    };

    setInitialFilters();
    applyFilters({ updateHistory: false });

    form?.addEventListener("submit", (event) => event.preventDefault());
    form?.addEventListener("input", () => applyFilters());
    form?.addEventListener("reset", () => window.setTimeout(() => applyFilters(), 0));

    document.querySelector<HTMLButtonElement>("[data-empty-reset]")?.addEventListener("click", () => {
      form?.reset();
      window.setTimeout(() => {
        applyFilters();
        searchInput?.focus();
      }, 0);
    });
  </script>
</BaseLayout>

<style>
  .archive-header {
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(217, 70, 239, 0.25);
  }

  .archive-header > div {
    display: flex;
    margin-top: 0.75rem;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .archive-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .archive-header div > p {
    max-width: 28rem;
    margin: 0 0 0.35rem;
    color: var(--ink-soft);
  }

  .archive {
    padding-block: 2rem clamp(4rem, 8vw, 7rem);
  }

  .filters {
    display: grid;
    padding: 1.25rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: var(--glass-shadow);
    grid-template-columns: minmax(15rem, 1.6fr) repeat(3, minmax(9rem, 0.75fr)) auto;
    gap: 0.85rem;
  }

  .field {
    min-width: 0;
  }

  .field label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .field input,
  .field select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(217, 70, 239, 0.25);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(8px);
    font-size: 0.84rem;
    transition: all 200ms ease;
  }

  .field input:focus,
  .field select:focus {
    border-color: var(--accent);
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 0 3px rgba(217, 70, 239, 0.25), 0 4px 16px rgba(217, 70, 239, 0.2);
    outline: none;
  }

  .field input::placeholder {
    color: var(--ink-soft);
    opacity: 0.9;
  }

  .clear-button {
    min-height: 2.75rem;
    margin-top: 1.35rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid rgba(217, 70, 239, 0.3);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    transition: all 200ms ease;
  }

  .clear-button:hover {
    border-color: var(--accent);
    background: rgba(217, 70, 239, 0.15);
    color: var(--accent-strong);
    box-shadow: 0 4px 12px rgba(217, 70, 239, 0.2);
  }

  .result-summary {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .result-summary strong {
    color: var(--ink);
  }

  .writeup-list {
    display: grid;
    grid-template-columns: 1fr;
  }

  .empty-state {
    max-width: 32rem;
    margin: 4rem auto;
    padding: 2.5rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: var(--glass-shadow);
    text-align: center;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-state h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
  }

  .empty-state p {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
  }

  .empty-state button {
    min-height: 2.75rem;
    margin-top: 1.25rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: rgba(217, 70, 239, 0.1);
    backdrop-filter: blur(8px);
    color: var(--accent-strong);
    font-weight: 700;
    transition: all 200ms ease;
  }

  .empty-state button:hover {
    background: rgba(217, 70, 239, 0.2);
    box-shadow: 0 4px 16px rgba(217, 70, 239, 0.25);
    transform: translateY(-1px);
  }

  @media (max-width: 64rem) {
    .filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .search-field {
      grid-column: 1 / -1;
    }

    .clear-button {
      margin-top: 0;
    }
  }

  @media (max-width: 42rem) {
    .archive-header > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .filters {
      padding: 1rem;
      grid-template-columns: 1fr;
    }

    .search-field {
      grid-column: auto;
    }

    .clear-button {
      width: 100%;
    }
  }
</style>
