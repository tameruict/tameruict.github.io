---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WriteupCard from "../../components/WriteupCard.astro";

const posts = (await getCollection("writeups", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const platformGroups = [...new Set(posts.map(({ data }) => data.platform))]
  .sort((a, b) => a.localeCompare(b))
  .map((platform) => ({
    platform,
    posts: posts.filter(({ data }) => data.platform === platform),
  }));
---

<BaseLayout
  title="Tất cả write-up"
  description="Write-up CTF được nhóm theo nền tảng và mức độ khó."
>
  <header class="archive-header shell">
    <h1>Tất cả write-up</h1>
    <p>{posts.length} bài viết</p>
  </header>

  <nav class="platform-nav shell" aria-label="Chọn nền tảng">
    {
      platformGroups.map(({ platform, posts: platformPosts }) => {
        const anchor = platform.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
        return (
          <a href={`#${anchor}`}>
            {platform}
            <span>{platformPosts.length}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="platform-groups shell">
    {
      platformGroups.map(({ platform, posts: platformPosts }) => {
        const anchor = platform.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
        return (
          <section class="platform-group" id={anchor} aria-labelledby={`${anchor}-title`}>
            <header>
              <h2 id={`${anchor}-title`}>{platform}</h2>
              <p>{platformPosts.length} bài</p>
            </header>
            <div class="writeup-grid">
              {platformPosts.map((post) => <WriteupCard post={post} />)}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .archive-header {
    display: flex;
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(2rem, 4vw, 3rem);
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .archive-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .archive-header p {
    margin: 0 0 0.35rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .platform-nav {
    display: flex;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .platform-nav a {
    display: inline-flex;
    gap: 0.45rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .platform-nav a:hover {
    color: var(--accent-strong);
  }

  .platform-nav span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .platform-groups {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .platform-group {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    scroll-margin-top: 2rem;
  }

  .platform-group + .platform-group {
    border-top: 1px solid var(--line-strong);
  }

  .platform-group > header {
    display: flex;
    margin-bottom: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .platform-group h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .platform-group header p {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .writeup-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
  }

  @media (max-width: 42rem) {
    .writeup-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
