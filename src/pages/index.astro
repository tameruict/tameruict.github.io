---
import { getCollection } from "astro:content";
import WriteupCard from "../components/WriteupCard.astro";
import { localizedPath, localeFromPath } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = localeFromPath(Astro.url.pathname);
const copy = locale === "vi"
  ? {
      description: "Write-up CTF của Tameru.",
      count: "bài viết",
      filter: "Tìm kiếm và lọc",
      list: "Danh sách write-up",
      empty: "Chưa có write-up.",
    }
  : {
      description: "CTF write-ups by Tameru.",
      count: "articles",
      filter: "Search and filter",
      list: "Write-up list",
      empty: "No write-ups yet.",
    };
const posts = (await getCollection("writeups", ({ data }) => !data.draft && data.language === locale)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout description={copy.description}>
  <header class="page-header shell">
    <div>
      <h1>Write-ups</h1>
      <p>{posts.length} {copy.count}</p>
    </div>
    <a href={localizedPath("/writeups/", locale)}>{copy.filter}</a>
  </header>

  <section class="writeup-index shell" aria-labelledby="writeup-list-title">
    <h2 class="visually-hidden" id="writeup-list-title">{copy.list}</h2>
    {
      posts.length > 0 ? (
        <div class="writeup-list">
          {posts.map((post) => <WriteupCard post={post} locale={locale} />)}
        </div>
      ) : (
        <p class="empty-state">{copy.empty}</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-header {
    display: flex;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid rgba(217, 70, 239, 0.25);
  }

  .page-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .page-header p {
    margin: 0.85rem 0 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .page-header a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.6rem 1rem;
    border: 1px solid rgba(217, 70, 239, 0.3);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: var(--accent-strong);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 200ms ease;
  }

  .page-header a:hover {
    background: rgba(217, 70, 239, 0.15);
    box-shadow: 0 4px 16px rgba(217, 70, 239, 0.25);
    transform: translateY(-1px);
  }

  .writeup-index {
    min-height: 48dvh;
    padding-block: 1.5rem clamp(5rem, 10vw, 8rem);
  }

  .empty-state {
    margin: 3rem 0;
    color: var(--ink-soft);
  }

  @media (max-width: 42rem) {
    .page-header {
      padding-top: 3.5rem;
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
