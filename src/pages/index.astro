---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WriteupCard from "../components/WriteupCard.astro";

const posts = (await getCollection("writeups", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const platforms = [...new Set(posts.map((post) => post.data.platform))].sort((a, b) =>
  a.localeCompare(b),
);
---

<BaseLayout description="Write-up CTF được phân loại theo nền tảng, chủ đề và độ khó.">
  <header class="page-header shell">
    <h1>Write-ups</h1>
  </header>

  <section class="archive shell" aria-label="Danh sách write-up">
    <form class="filters" data-filter-form role="search">
      <div class="field search-field">
        <label for="writeup-search">Tìm kiếm</label>
        <input
          id="writeup-search"
          name="query"
          type="search"
          autocomplete="off"
          placeholder="Tên challenge, tag hoặc kỹ thuật"
        />
      </div>

      <div class="field">
        <label for="platform-filter">Nền tảng</label>
        <select id="platform-filter" name="platform">
          <option value="">Tất cả</option>
          {platforms.map((platform) => <option value={platform}>{platform}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="difficulty-filter">Độ khó</label>
        <select id="difficulty-filter" name="difficulty">
          <option value="">Tất cả</option>
          <option value="Easy">Easy</option>
          <option value="Medium">Medium</option>
          <option value="Hard">Hard</option>
          <option value="Insane">Insane</option>
        </select>
      </div>

      <button class="clear-button" type="reset">Đặt lại</button>
    </form>

    <div class="result-count" aria-live="polite">
      <strong data-visible-count>{posts.length}</strong>
      <span>trên {posts.length} bài</span>
    </div>

    {
      posts.length > 0 ? (
        <div class="writeup-list" data-writeup-list>
          {posts.map((post) => <WriteupCard post={post} />)}
        </div>
      ) : (
        <div class="empty-state static-empty">
          <h2>Chưa có bài viết</h2>
          <p>Đổi một bài từ draft sang public để hiển thị tại đây.</p>
        </div>
      )
    }

    <div class="empty-state" data-filter-empty hidden aria-live="polite">
      <h2>Không có kết quả</h2>
      <p>Hãy điều chỉnh từ khóa hoặc bộ lọc.</p>
      <button type="button" data-empty-reset>Hiện tất cả</button>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-filter-form]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-writeup-card]")];
    const visibleCount = document.querySelector<HTMLElement>("[data-visible-count]");
    const emptyState = document.querySelector<HTMLElement>("[data-filter-empty]");
    const searchInput = document.querySelector<HTMLInputElement>("#writeup-search");
    const platformSelect = document.querySelector<HTMLSelectElement>("#platform-filter");
    const difficultySelect = document.querySelector<HTMLSelectElement>("#difficulty-filter");

    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLocaleLowerCase("vi")
        .trim();

    const applyFilters = () => {
      if (!searchInput || !platformSelect || !difficultySelect) return;

      const query = normalize(searchInput.value);
      const platform = platformSelect.value;
      const difficulty = difficultySelect.value;
      let count = 0;

      cards.forEach((card) => {
        const searchText = normalize(card.dataset.search ?? "");
        const matches =
          (!query || searchText.includes(query)) &&
          (!platform || card.dataset.platform === platform) &&
          (!difficulty || card.dataset.difficulty === difficulty);

        card.hidden = !matches;
        if (matches) count += 1;
      });

      if (visibleCount) visibleCount.textContent = String(count);
      if (emptyState) emptyState.hidden = count !== 0 || cards.length === 0;
    };

    form?.addEventListener("input", applyFilters);
    form?.addEventListener("reset", () => window.setTimeout(applyFilters, 0));

    document.querySelector<HTMLButtonElement>("[data-empty-reset]")?.addEventListener("click", () => {
      form?.reset();
      window.setTimeout(() => {
        applyFilters();
        searchInput?.focus();
      }, 0);
    });
  </script>
</BaseLayout>

<style>
  .page-header {
    padding: 3.5rem 0 2rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .page-header h1 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .result-count {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .archive {
    padding-block: 2rem clamp(4rem, 8vw, 7rem);
  }

  .filters {
    display: grid;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
    grid-template-columns: minmax(14rem, 1.8fr) minmax(10rem, 0.8fr) minmax(9rem, 0.7fr) auto;
    gap: 0.85rem;
  }

  .field {
    min-width: 0;
  }

  .field label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .field input,
  .field select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 0.88rem;
  }

  .field input:focus,
  .field select:focus {
    border-color: var(--accent);
    box-shadow: var(--shadow-focus);
    outline: none;
  }

  .field input::placeholder {
    color: var(--ink-soft);
  }

  .clear-button {
    min-height: 2.75rem;
    margin-top: 1.55rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .clear-button:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .result-count {
    display: flex;
    margin-block: 1.25rem 0;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .result-count strong {
    color: var(--ink);
  }

  .writeup-list {
    display: grid;
    margin-top: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
  }

  .empty-state {
    max-width: 34rem;
    margin: 4rem auto;
    padding: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-state h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .empty-state p {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
  }

  .empty-state button {
    min-height: 2.6rem;
    margin-top: 1.25rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--accent-strong);
    font-weight: 600;
  }

  @media (max-width: 54rem) {
    .filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .search-field {
      grid-column: 1 / -1;
    }

    .clear-button {
      margin-top: 0;
    }
  }

  @media (max-width: 42rem) {
    .page-header {
      padding-top: 2.75rem;
    }

    .filters,
    .writeup-list {
      grid-template-columns: 1fr;
    }

    .search-field {
      grid-column: auto;
    }

    .clear-button {
      width: 100%;
    }
  }
</style>
