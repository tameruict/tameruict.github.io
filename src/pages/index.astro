---
import { getCollection } from "astro:content";
import WriteupCard from "../components/WriteupCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("writeups", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout description="Write-up CTF của Tameru.">
  <header class="page-header shell">
    <div>
      <h1>Write-ups</h1>
      <p>{posts.length} bài viết</p>
    </div>
    <a href="/writeups/">Tìm kiếm và lọc</a>
  </header>

  <section class="writeup-index shell" aria-labelledby="writeup-list-title">
    <h2 class="visually-hidden" id="writeup-list-title">Danh sách write-up</h2>
    {
      posts.length > 0 ? (
        <div class="writeup-list">
          {posts.map((post) => <WriteupCard post={post} />)}
        </div>
      ) : (
        <p class="empty-state">Chưa có write-up.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-header {
    display: flex;
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2rem, 5vw, 3.5rem);
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .page-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .page-header p {
    margin: 0.85rem 0 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .page-header a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--accent-strong);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .writeup-index {
    min-height: 48dvh;
    padding-block: 1.5rem clamp(5rem, 10vw, 8rem);
  }

  .empty-state {
    margin: 3rem 0;
    color: var(--ink-soft);
  }

  @media (max-width: 42rem) {
    .page-header {
      padding-top: 3.5rem;
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
