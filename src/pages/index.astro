---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WriteupCard from "../components/WriteupCard.astro";

const allPosts = await getCollection("writeups", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : [];
const platforms = [...new Set(posts.map((post) => post.data.platform))].sort((a, b) =>
  a.localeCompare(b),
);
const platformCounts = new Map(
  platforms.map((platform) => [
    platform,
    posts.filter((post) => post.data.platform === platform).length,
  ]),
);
---

<BaseLayout
  description="Write-up CTF từ Hack The Box, picoCTF và nhiều sân chơi khác, được phân loại theo nền tảng, chủ đề và độ khó."
>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">CTF field notes</p>
      <h1 id="hero-title">
        Mổ xẻ challenge.<br />
        <em>Giữ lại cách nghĩ.</em>
      </h1>
      <p class="hero-intro">
        Write-up từ những lần mắc kẹt, thử sai và tìm ra lời giải. Tập trung vào tư duy khai thác,
        kỹ thuật có thể dùng lại và những chi tiết dễ bị bỏ qua.
      </p>
    </div>

    <aside class="hero-index" aria-label="Chỉ mục nền tảng">
      <p>Nền tảng</p>
      <ol>
        {
          platforms.map((platform, index) => (
            <li>
              <button type="button" data-platform-shortcut={platform}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{platform}</strong>
                <small>{platformCounts.get(platform)} bài</small>
              </button>
            </li>
          ))
        }
      </ol>
    </aside>
  </section>

  <section class="archive shell" aria-labelledby="archive-title">
    <header class="archive-heading">
      <div>
        <p class="eyebrow">Kho write-up</p>
        <h2 id="archive-title">Chọn đúng thứ anh cần</h2>
      </div>
      <p class="archive-count">
        <strong data-visible-count>{posts.length}</strong>
        <span>/ {posts.length} bài đang hiển thị</span>
      </p>
    </header>

    <form class="filters" data-filter-form role="search">
      <div class="field search-field">
        <label for="writeup-search">Tìm theo tên, tag hoặc kỹ thuật</label>
        <input
          id="writeup-search"
          name="query"
          type="search"
          autocomplete="off"
          placeholder="Ví dụ: SQLi, heap, RSA..."
        />
      </div>

      <div class="field">
        <label for="platform-filter">Nền tảng</label>
        <select id="platform-filter" name="platform">
          <option value="">Tất cả nền tảng</option>
          {platforms.map((platform) => <option value={platform}>{platform}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="difficulty-filter">Độ khó</label>
        <select id="difficulty-filter" name="difficulty">
          <option value="">Mọi độ khó</option>
          <option value="Easy">Easy</option>
          <option value="Medium">Medium</option>
          <option value="Hard">Hard</option>
          <option value="Insane">Insane</option>
        </select>
      </div>

      <button class="clear-button" type="reset">Xóa bộ lọc</button>
    </form>

    {
      posts.length > 0 ? (
        <div class="writeup-list" data-writeup-list>
          {featuredPost && <WriteupCard post={featuredPost} featured />}
          {remainingPosts.map((post) => <WriteupCard post={post} />)}
        </div>
      ) : (
        <div class="empty-state static-empty">
          <p class="eyebrow">Chưa có bài public</p>
          <h3>Write-up đầu tiên đang được chuẩn bị.</h3>
          <p>Quay lại sau nhé. Kho ghi chép sẽ sớm có bài mới.</p>
        </div>
      )
    }

    <div class="empty-state" data-filter-empty hidden aria-live="polite">
      <p class="eyebrow">Không tìm thấy</p>
      <h3>Chưa có write-up khớp bộ lọc này.</h3>
      <p>Thử đổi từ khóa, nền tảng hoặc mức độ khó.</p>
      <button type="button" data-empty-reset>Hiện tất cả bài</button>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-filter-form]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-writeup-card]")];
    const visibleCount = document.querySelector<HTMLElement>("[data-visible-count]");
    const emptyState = document.querySelector<HTMLElement>("[data-filter-empty]");
    const searchInput = document.querySelector<HTMLInputElement>("#writeup-search");
    const platformSelect = document.querySelector<HTMLSelectElement>("#platform-filter");
    const difficultySelect = document.querySelector<HTMLSelectElement>("#difficulty-filter");

    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLocaleLowerCase("vi")
        .trim();

    const applyFilters = () => {
      if (!searchInput || !platformSelect || !difficultySelect) return;

      const query = normalize(searchInput.value);
      const platform = platformSelect.value;
      const difficulty = difficultySelect.value;
      let count = 0;

      cards.forEach((card) => {
        const searchText = normalize(card.dataset.search ?? "");
        const matches =
          (!query || searchText.includes(query)) &&
          (!platform || card.dataset.platform === platform) &&
          (!difficulty || card.dataset.difficulty === difficulty);

        card.hidden = !matches;
        if (matches) count += 1;
      });

      if (visibleCount) visibleCount.textContent = String(count);
      if (emptyState) emptyState.hidden = count !== 0 || cards.length === 0;
    };

    form?.addEventListener("input", applyFilters);
    form?.addEventListener("reset", () => window.setTimeout(applyFilters, 0));

    document.querySelectorAll<HTMLButtonElement>("[data-platform-shortcut]").forEach((button) => {
      button.addEventListener("click", () => {
        if (!platformSelect) return;
        platformSelect.value = button.dataset.platformShortcut ?? "";
        applyFilters();
        document.querySelector("#archive-title")?.scrollIntoView({ behavior: "smooth" });
      });
    });

    document.querySelector<HTMLButtonElement>("[data-empty-reset]")?.addEventListener("click", () => {
      form?.reset();
      window.setTimeout(() => {
        applyFilters();
        searchInput?.focus();
      }, 0);
    });
  </script>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: clamp(36rem, 76vh, 48rem);
    padding-block: clamp(5rem, 11vw, 9rem);
    align-items: end;
    grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy {
    align-self: center;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 8.2vw, 7.8rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.88;
    text-wrap: balance;
  }

  h1 em {
    color: var(--accent);
    font-weight: 400;
  }

  .hero-intro {
    max-width: 39rem;
    margin: clamp(2rem, 4vw, 3.2rem) 0 0 clamp(2rem, 6vw, 7rem);
    color: var(--ink-soft);
    font-size: clamp(1rem, 0.9rem + 0.42vw, 1.25rem);
    line-height: 1.6;
  }

  .hero-index {
    padding-bottom: 0.25rem;
  }

  .hero-index > p {
    margin: 0 0 0.8rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-index ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-index li {
    border-top: 1px solid var(--line);
  }

  .hero-index li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .hero-index button {
    display: grid;
    width: 100%;
    min-height: 3.8rem;
    padding: 0.55rem 0;
    align-items: center;
    border: 0;
    background: transparent;
    grid-template-columns: 2.3rem 1fr auto;
    gap: 0.7rem;
    text-align: left;
  }

  .hero-index button span,
  .hero-index button small {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .hero-index button strong {
    font-family: var(--font-display);
    font-size: 1rem;
    transition: color 160ms ease, transform 160ms ease;
  }

  .hero-index button:hover strong {
    color: var(--accent);
    transform: translateX(0.2rem);
  }

  .archive {
    padding-top: clamp(4rem, 8vw, 7rem);
  }

  .archive-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .archive-heading h2 {
    max-width: 14ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.8vw, 5.8rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    overflow-wrap: normal;
    word-break: keep-all;
  }

  .archive-count {
    display: flex;
    margin: 0 0 0.4rem;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .archive-count strong {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 2.2rem;
  }

  .filters {
    display: grid;
    margin-block: clamp(2.5rem, 5vw, 4.5rem);
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgb(255 250 250 / 72%);
    grid-template-columns: minmax(14rem, 1.6fr) minmax(10rem, 0.8fr) minmax(10rem, 0.7fr) auto;
    gap: 0.75rem;
  }

  .field {
    min-width: 0;
  }

  .field label {
    display: block;
    margin: 0 0 0.38rem 0.1rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .field input,
  .field select {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 0.88rem;
  }

  .field input:focus,
  .field select:focus {
    border-color: var(--accent);
    box-shadow: var(--shadow-focus);
    outline: none;
  }

  .field input::placeholder {
    color: #987982;
  }

  .clear-button {
    min-height: 3rem;
    margin-top: 1.45rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .clear-button:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .writeup-list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2.2rem, 4vw, 4rem) clamp(1.5rem, 3vw, 3rem);
  }

  .writeup-list :global(.writeup-card) {
    grid-column: span 6;
  }

  .writeup-list :global(.writeup-card.featured) {
    grid-column: 1 / -1;
    width: min(100%, 58rem);
    margin-left: auto;
  }

  .writeup-list :global(.writeup-card:nth-child(4n + 2)) {
    grid-column: 2 / span 5;
  }

  .writeup-list :global(.writeup-card:nth-child(4n + 3)) {
    grid-column: 7 / span 6;
  }

  .empty-state {
    max-width: 46rem;
    margin: 5rem auto;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-align: center;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-state h3 {
    margin: 0;
    color: var(--accent-strong);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.8rem);
  }

  .empty-state > p:last-of-type {
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
  }

  .empty-state button {
    min-height: 2.8rem;
    margin-top: 1.4rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--paper);
    font-weight: 700;
  }

  @media (max-width: 54rem) {
    .hero {
      min-height: auto;
      padding-block: 2rem;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    h1 {
      font-size: clamp(3rem, 13vw, 4.8rem);
    }

    .hero-intro {
      margin-left: 0;
    }

    .hero-index {
      width: min(100%, 34rem);
      margin-left: auto;
    }

    .filters {
      grid-template-columns: 1fr 1fr;
    }

    .search-field {
      grid-column: 1 / -1;
    }

    .clear-button {
      margin-top: 0;
    }
  }

  @media (max-width: 42rem) {
    .hero {
      padding-block: 4rem 5rem;
    }

    h1 {
      font-size: clamp(3.15rem, 16vw, 5.5rem);
    }

    .archive-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.3rem;
    }

    .archive-heading h2 {
      max-width: 11ch;
      font-size: clamp(2.55rem, 13vw, 4rem);
      letter-spacing: -0.035em;
    }

    .filters {
      padding: 0.8rem;
      grid-template-columns: 1fr;
    }

    .search-field {
      grid-column: auto;
    }

    .writeup-list {
      display: block;
    }

    .writeup-list :global(.writeup-card) {
      margin-bottom: 3rem;
    }

    .writeup-list :global(.writeup-card.featured) {
      width: 100%;
      margin-bottom: 3.5rem;
    }
  }
</style>
