---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Không tìm thấy trang" description="Trang được yêu cầu không tồn tại.">
  <section class="not-found shell">
    <p class="code">404</p>
    <h1>Không tìm thấy trang</h1>
    <p>Đường dẫn có thể đã thay đổi hoặc bài viết chưa được công bố.</p>
    <a href="/">Về trang chủ</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: 65dvh;
    padding-block: 4rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .code {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .not-found > p:not(.code) {
    max-width: 36rem;
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }

  a {
    margin-top: 1.75rem;
    color: var(--accent-strong);
    font-weight: 600;
  }
</style>
