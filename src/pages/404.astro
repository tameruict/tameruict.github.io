---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Không tìm thấy trang" description="Trang được yêu cầu không tồn tại.">
  <section class="not-found shell">
    <div class="error-code" aria-hidden="true">404</div>
    <div>
      <p class="section-label">Không tìm thấy</p>
      <h1>Đường dẫn này không còn ở đây.</h1>
      <p>Bài viết có thể chưa được công bố hoặc URL đã thay đổi.</p>
      <div class="actions">
        <a href="/">Về trang chủ</a>
        <a href="/writeups/">Tìm trong write-up</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 68dvh;
    padding-block: 4rem;
    align-items: center;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(2rem, 8vw, 7rem);
  }

  .error-code {
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: clamp(5rem, 16vw, 11rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  h1 {
    max-width: 13ch;
    margin: 0.8rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .not-found div > p:not(.section-label) {
    max-width: 36rem;
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    margin-top: 1.75rem;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .actions a {
    display: inline-flex;
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    align-items: center;
    border: 1px solid rgba(217, 70, 239, 0.3);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: none;
    transition: all 200ms ease;
  }

  .actions a:hover {
    background: rgba(217, 70, 239, 0.2);
    box-shadow: 0 4px 16px rgba(217, 70, 239, 0.25);
    transform: translateY(-1px);
  }

  .actions a:last-child {
    background: rgba(255, 255, 255, 0.15);
    color: var(--ink-soft);
    font-weight: 600;
  }

  .actions a:last-child:hover {
    background: rgba(255, 255, 255, 0.25);
    color: var(--ink);
  }

  @media (max-width: 42rem) {
    .not-found {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .error-code {
      font-size: 5rem;
    }
  }
</style>
